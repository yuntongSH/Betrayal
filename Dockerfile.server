# The authoritative game server (packages/server) for hosted multiplayer.
# Built from the repo root so the workspace's shared rules engine comes along:
#   docker build -f Dockerfile.server .
# Fly.io picks this up via fly.toml; the edge terminates TLS, so clients
# connect with wss://<app>.fly.dev while the container speaks plain ws.
FROM node:22-alpine

WORKDIR /app
RUN corepack enable

# Install with the lockfile first so Docker caches the dependency layer.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
RUN pnpm install --frozen-lockfile --filter "@dread-hollow/server..."

COPY packages/shared packages/shared
COPY packages/server packages/server

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["pnpm", "--filter", "@dread-hollow/server", "start"]
